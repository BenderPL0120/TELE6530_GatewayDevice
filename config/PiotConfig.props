#####
# Configuration file for the Gateway Device App (GDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# Cloud client configuration information
#
[Cloud.GatewayService]
credFile       = ubidots/UbidotsCloudCred.props
certFile       = ubidots/UbidotsCloudCert.pem
host           = industrial.api.ubidots.com
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 60
useAsyncClient = True
enableAuth     = True
enableCrypt    = True
baseUrl        =
baseTopic      = /v1.6/devices/

#
# SMTP client configuration information
#
[Smtp.GatewayService]
credFile       = ./cred/PiotSmtpCred.props
host           = localhost
port           = 25
securePort     = 587
enableAuth     = True
enableCrypt    = True

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
credFile       = ./cred/PiotMqttCred.props
certFile       = ./cert/ca.crt
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 300
enableAuth     = False
enableCrypt    = True
useAsyncClient = True

#
# CoAP client and server configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False
enableConfirmedMsgs = True

#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID        = gatewaydevice001
enableLogging           = True
pollCycleSecs           = 60
enableRunForever        = True
enableMqttClient        = True
enableCoapServer        = False
enableCoapClient        = False
enableCloudClient       = True
enableSmtpClient        = False
enablePersistenceClient = False
enableSystemPerformance = False
testGdaDataPath         = /tmp/gda-data
testCdaDataPath         = /tmp/cda-data
testEmptyApp            = False

# Humidity control configuration
handleHumidityChangeOnDevice    = True
humidityMaxTimePastThreshold    = 180
nominalHumiditySetting          = 40.0
triggerHumidifierFloor          = 30.0
triggerHumidifierCeiling        = 50.0

# Temperature control configuration
handleTempChangeOnDevice        = True
tempMaxTimePastThreshold        = 180
nominalTempSetting              = 20.0
triggerTempFloor                = 10.0
triggerTempCeiling              = 30.0

# Pressure control configuration
handlePressureChangeOnDevice    = True
pressureMaxTimePastThreshold    = 180
nominalPressureSetting          = 1000.0
triggerPressureFloor            = 950.0
triggerPressureCeiling          = 1050.0

# Orientation control configuration (Pitch - Controls Window)
# Pitch > 50.0 = OPEN, Pitch < -10.0 = CLOSE
handleOrientationChangeOnDevice = True
orientationMaxTimePastThreshold = 60
nominalOrientationSetting       = 0.0
triggerOrientationFloor         = -10.0
triggerOrientationCeiling       = 50.0

# Magnetic control configuration (Yaw - Safety Wind Lock)
# Yaw inside (-50.0, 50.0) = Windy/Unsafe -> Force CLOSE
handleMagneticChangeOnDevice    = True
magneticMaxTimePastThreshold    = 60
nominalMagneticSetting          = 180.0
triggerMagneticFloor            = -50.0
triggerMagneticCeiling          = 50.0
